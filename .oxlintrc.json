{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue", "vitest"],
  "env": {
    "browser": true
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "src/auto-imports.d.ts",
    "src/components.d.ts",
    "test-results/**",
    "playwright-report/**",
    ".claude/**"
  ],
  "rules": {
    "no-empty-pattern": "off"
  }
}
